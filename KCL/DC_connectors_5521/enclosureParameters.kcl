// PCB enclosure parameters
// Shared board, shell, hole, and clearance dimensions.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

export boardLength = 30mm
export boardWidth = 20mm
export boardThickness = 1.57mm
export frontComponentHeight = 7mm
export backComponentHeight = 1mm
export wallThickness = 1.2mm
export cornerRadius = 6mm
export boardClearance = 0mm
export topComponentClearance = 0mm
export bottomComponentClearance = 0mm

export upperInnerLength = 42mm
export upperInnerWidth = 20mm
export upperInternalHeight = 7mm
export lowerInnerLength = 42mm
export lowerInnerWidth = 20mm
export lowerInternalHeight = 6mm
export innerLength = upperInnerLength
export innerWidth = upperInnerWidth
export innerCornerRadius = cornerRadius - wallThickness
export outerLength = innerLength + 2 * wallThickness
export outerWidth = innerWidth + 2 * wallThickness
export upperOuterHeight = upperInternalHeight + wallThickness
export lowerOuterHeight = lowerInternalHeight + boardThickness + wallThickness

export boardTopZ = boardThickness / 2
export boardBottomZ = -boardThickness / 2
export upperOuterBottomZ = boardTopZ
export upperOuterTopZ = boardTopZ + upperOuterHeight
export lowerOuterTopZ = boardTopZ
export lowerOuterBottomZ = boardBottomZ - lowerInternalHeight - wallThickness
export lowerFloorTopZ = lowerOuterBottomZ + wallThickness
export lowerPilotStartZ = lowerOuterBottomZ + 0.35mm

export mountHoleDistanceInbetween = 27mm
export mountHoleX = mountHoleDistanceInbetween / 2
export mountHoleY = 0mm
export screwClearanceDiameter = 2.7mm
export lowerPilotDiameter = 2.1mm
export bossOuterDiameter = 5.8mm
export screwHeadPocketDiameter = 5.4mm
export screwHeadPocketDepth = 1.4mm
export ventHoleDiameter = 0.9mm
export ventPitch = 3mm
export ventRowY = 3.2mm
export csgOverlap = 0.25mm
export endPortDiameter = 10mm

export frontEnvelopeLength = 11.4mm
export frontEnvelopeWidth = 20mm
export backEnvelopeLength = 11.4mm
export backEnvelopeWidth = 20mm

export upperShellColor = "#cfd6df"
export lowerShellColor = "#aeb8c4"
export pcbColor = "#176b3a"
export componentColor = "#2b2f33"
