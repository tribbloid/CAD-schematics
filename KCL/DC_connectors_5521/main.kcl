@settings(defaultLengthUnit = mm, kclVersion = 1.0)

// =========================
// PARAMETERS - Enclosure
// =========================
encLength = 60
encWidth = 35
encHeight = 28
encWall = 3

// Wire openings (for 14 AWG insulated wires)
wireOuterDia = 3.5
wireCount = 2
wireCenterSpacing = 8
wireHoleDepth = encWall + 2 // ensure cut passes through the wall


// M10 threaded hole (nominal 10 mm)
threadHoleDia = 10
threadHoleDepth = encWall + 2

// =========================
// PARAMETERS - Protector
// =========================
protLength = 25
protOuterDia = 18
protInnerDia = 11.7 // threaded screw hole for DC jack (modeled as through bore)


// Cable clamp on protector
cableDia = 3
clampHeight = 6
clampThickness = 5
clampOverhang = 6 // how far the clamp extends past the cylinder OD
clampHoleDia = 3.2 // slight clearance for 3 mm cable


// =========================
// ENCLOSURE BODY (open-top shell)
// =========================
// Create base box centered on XY using a corner, then extrude up
encSketch = startSketchOn(XY)
  |> rectangle(corner = [-encWidth / 2, -encLength / 2], width = encWidth, height = encLength)
encBody = extrude(encSketch, length = encHeight)
  |> shell(faces = [END], thickness = encWall)

  // -------------------------
  // HOLES IN ENCLOSURE WALLS
  // -------------------------
// Wire openings on the -X side wall (two holes vertically centered, spaced along Y)
wirePlaneNegX = offsetPlane(YZ, offset = -(encWidth / 2 - (encWall / 2)))

wireHolesSketch = startSketchOn(wirePlaneNegX)
  |> circle(center = [-wireCenterSpacing / 2, encHeight / 2], diameter = wireOuterDia)
profile1 = circle(wireHolesSketch, center = [wireCenterSpacing / 2, encHeight / 2], diameter = wireOuterDia) // extrudes along +X from the -X wall


wireCutTools = extrude([wireHolesSketch, profile1], length = wireHoleDepth)
// M10 threaded hole on the +X side wall (centered in Y, mid-height in Z)
threadPlanePosX = offsetPlane(YZ, offset = encWidth / 2 - (encWall / 2))
threadSketch = startSketchOn(threadPlanePosX)
  |> circle(center = [0, encHeight / 2], diameter = threadHoleDia)
threadCutTool = extrude(threadSketch, length = threadHoleDepth)

// Subtract all wall holes from enclosure
enclosure = subtract(encBody, tools = concat([wireCutTools], items = [threadCutTool]))

// =========================
// THREADED DC JACK PROTECTOR
// =========================
// Main cylindrical sleeve along Y axis
protSketch = startSketchOn(XZ)
  |> circle(center = [0, 0], diameter = protOuterDia)
protectorBody = extrude(protSketch, length = protLength)

// Clamp tab on top side near the end of the protector
// Sketch the tab on the START face so the extrusion merges automatically
tabCenterZ = protLength - (clampHeight / 2) // spans cylinder diameter plus overhang
tabWidthX = protOuterDia + clampOverhang
tabMerged = startSketchOn(protectorBody, face = START)
  |> rectangle(center = [0, tabCenterZ], width = tabWidthX, height = clampHeight)
  |> extrude(length = clampThickness)

// Through bore for DC jack thread (11.7 mm)
boreSketch = startSketchOn(tabMerged, face = START)
  |> circle(center = [0, 0], diameter = protInnerDia)
boreTool = extrude(boreSketch, length = protLength, method = NEW)
protectorAfterBore = subtract(tabMerged, tools = boreTool)

// Cable hole through the clamp tab (along Y axis)
clampHoleSketch = startSketchOn(XZ)
  |> circle(center = [0, tabCenterZ], diameter = clampHoleDia)
clampHoleTool = extrude(clampHoleSketch, length = clampThickness, method = NEW)

// Final protector: subtract the clamp hole
protector = subtract(protectorAfterBore, tools = clampHoleTool)

// Optional visual separation
translate(enclosure, x = -60)
translate(protector, x = 60)
