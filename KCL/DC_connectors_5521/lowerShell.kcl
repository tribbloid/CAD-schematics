// Lower enclosure shell
// Rounded base with blind M2.5 pilot bosses and underside hex-nut traps.
@settings(defaultLengthUnit = mm, kclVersion = 2.0, experimentalFeatures = allow)

import * from "enclosureParameters.kcl"

lowerOuterProfile = sketch(on = offsetPlane(XY, offset = lowerOuterBottomZ)) {
  rightSide = line(start = [var 22.2mm, var -5.2mm], end = [var 22.2mm, var 5.2mm])
  arcTr = arc(start = [var 22.2mm, var 5.2mm], end = [var 16.2mm, var 11.2mm], center = [var 16.2mm, var 5.2mm])
  topSide = line(start = [var 16.2mm, var 11.2mm], end = [var -16.2mm, var 11.2mm])
  arcTl = arc(start = [var -16.2mm, var 11.2mm], end = [var -22.2mm, var 5.2mm], center = [var -16.2mm, var 5.2mm])
  leftSide = line(start = [var -22.2mm, var 5.2mm], end = [var -22.2mm, var -5.2mm])
  arcBl = arc(start = [var -22.2mm, var -5.2mm], end = [var -16.2mm, var -11.2mm], center = [var -16.2mm, var -5.2mm])
  bottomSide = line(start = [var -16.2mm, var -11.2mm], end = [var 16.2mm, var -11.2mm])
  arcBr = arc(start = [var 16.2mm, var -11.2mm], end = [var 22.2mm, var -5.2mm], center = [var 16.2mm, var -5.2mm])

  coincident([rightSide.end, arcTr.start])
  coincident([arcTr.end, topSide.start])
  coincident([topSide.end, arcTl.start])
  coincident([arcTl.end, leftSide.start])
  coincident([leftSide.end, arcBl.start])
  coincident([arcBl.end, bottomSide.start])
  coincident([bottomSide.end, arcBr.start])
  coincident([arcBr.end, rightSide.start])
  vertical(rightSide)
  horizontal(topSide)
  vertical(leftSide)
  horizontal(bottomSide)
  horizontal([arcTr.start, arcTr.center])
  vertical([arcTr.end, arcTr.center])
  horizontal([arcTl.end, arcTl.center])
  vertical([arcTl.start, arcTl.center])
  horizontal([arcBl.start, arcBl.center])
  vertical([arcBl.end, arcBl.center])
  horizontal([arcBr.end, arcBr.center])
  vertical([arcBr.start, arcBr.center])
  horizontal([arcTl.center, arcTr.center])
  horizontal([arcBl.center, arcBr.center])
  vertical([arcTr.center, arcBr.center])
  vertical([arcTl.center, arcBl.center])
  equalRadius([arcTr, arcTl, arcBl, arcBr])
  radius(arcTr) == cornerRadius
  horizontalDistance([arcTl.center, arcTr.center]) == outerLength - (2 * cornerRadius)
  verticalDistance([arcBr.center, arcTr.center]) == outerWidth - (2 * cornerRadius)
  horizontalDistance([ORIGIN, arcTr.center]) == outerLength / 2 - cornerRadius
  verticalDistance([ORIGIN, arcTr.center]) == outerWidth / 2 - cornerRadius
}
lowerOuterRaw = extrude(region(point = [0mm, 0mm], sketch = lowerOuterProfile), length = lowerOuterHeight, method = NEW)

lowerCavityProfile = sketch(on = offsetPlane(XY, offset = lowerFloorTopZ)) {
  rightSide = line(start = [var 21mm, var -5.2mm], end = [var 21mm, var 5.2mm])
  arcTr = arc(start = [var 21mm, var 5.2mm], end = [var 16.2mm, var 10mm], center = [var 16.2mm, var 5.2mm])
  topSide = line(start = [var 16.2mm, var 10mm], end = [var -16.2mm, var 10mm])
  arcTl = arc(start = [var -16.2mm, var 10mm], end = [var -21mm, var 5.2mm], center = [var -16.2mm, var 5.2mm])
  leftSide = line(start = [var -21mm, var 5.2mm], end = [var -21mm, var -5.2mm])
  arcBl = arc(start = [var -21mm, var -5.2mm], end = [var -16.2mm, var -10mm], center = [var -16.2mm, var -5.2mm])
  bottomSide = line(start = [var -16.2mm, var -10mm], end = [var 16.2mm, var -10mm])
  arcBr = arc(start = [var 16.2mm, var -10mm], end = [var 21mm, var -5.2mm], center = [var 16.2mm, var -5.2mm])

  coincident([rightSide.end, arcTr.start])
  coincident([arcTr.end, topSide.start])
  coincident([topSide.end, arcTl.start])
  coincident([arcTl.end, leftSide.start])
  coincident([leftSide.end, arcBl.start])
  coincident([arcBl.end, bottomSide.start])
  coincident([bottomSide.end, arcBr.start])
  coincident([arcBr.end, rightSide.start])
  vertical(rightSide)
  horizontal(topSide)
  vertical(leftSide)
  horizontal(bottomSide)
  horizontal([arcTr.start, arcTr.center])
  vertical([arcTr.end, arcTr.center])
  horizontal([arcTl.end, arcTl.center])
  vertical([arcTl.start, arcTl.center])
  horizontal([arcBl.start, arcBl.center])
  vertical([arcBl.end, arcBl.center])
  horizontal([arcBr.end, arcBr.center])
  vertical([arcBr.start, arcBr.center])
  horizontal([arcTl.center, arcTr.center])
  horizontal([arcBl.center, arcBr.center])
  vertical([arcTr.center, arcBr.center])
  vertical([arcTl.center, arcBl.center])
  equalRadius([arcTr, arcTl, arcBl, arcBr])
  radius(arcTr) == innerCornerRadius
  horizontalDistance([arcTl.center, arcTr.center]) == innerLength - (2 * innerCornerRadius)
  verticalDistance([arcBr.center, arcTr.center]) == innerWidth - (2 * innerCornerRadius)
  horizontalDistance([ORIGIN, arcTr.center]) == innerLength / 2 - innerCornerRadius
  verticalDistance([ORIGIN, arcTr.center]) == innerWidth / 2 - innerCornerRadius
}
lowerCavityCut = extrude(region(point = [0mm, 0mm], sketch = lowerCavityProfile), length = lowerOuterHeight - wallThickness + csgOverlap, method = NEW)
lowerShellHollow = subtract([lowerOuterRaw], tools = [lowerCavityCut])

lowerBossLeftProfile = sketch(on = offsetPlane(XY, offset = lowerOuterBottomZ)) {
  guide = line(start = [var 0mm, var 0mm], end = [var 2.9mm, var 0mm], construction = true)
  c = circle(start = [var 2.9mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([guide.start, ORIGIN])
  coincident([c.center, guide.start])
  coincident([c.start, guide.end])
  horizontal(guide)
  horizontalDistance([guide.start, guide.end]) == bossOuterDiameter / 2
}
lowerBossLeftRaw = extrude(region(point = [0mm, 0mm], sketch = lowerBossLeftProfile), length = boardBottomZ - lowerOuterBottomZ, method = NEW)
  |> translate(x = -mountHoleX, y = mountHoleY, global = true)
hide(lowerBossLeftProfile)
lowerBossRightRaw = clone(lowerBossLeftRaw)
  |> translate(x = 2 * mountHoleX, global = true)

lowerBodyMerged = union([
  lowerShellHollow[0],
  lowerBossLeftRaw,
  lowerBossRightRaw
])

lowerPilotProfile = sketch(on = offsetPlane(XY, offset = lowerPilotStartZ)) {
  guide = line(start = [var 0mm, var 0mm], end = [var 1.05mm, var 0mm], construction = true)
  c = circle(start = [var 1.05mm, var 0mm], center = [var 0mm, var 0mm])
  coincident([guide.start, ORIGIN])
  coincident([c.center, guide.start])
  coincident([c.start, guide.end])
  horizontal(guide)
  diameter(c) == lowerPilotDiameter
}
lowerPilotCutLeft = extrude(region(point = [0mm, 0mm], sketch = lowerPilotProfile), length = boardBottomZ - lowerPilotStartZ + csgOverlap, method = NEW)
  |> translate(x = -mountHoleX, y = mountHoleY, global = true)
lowerPilotCutRight = clone(lowerPilotCutLeft)
  |> translate(x = 2 * mountHoleX, global = true)

lowerShellCut = subtract(lowerBodyMerged, tools = [lowerPilotCutLeft, lowerPilotCutRight])

lowerNutPocketProfile = sketch(on = offsetPlane(XY, offset = lowerOuterBottomZ - csgOverlap)) {
  side1 = line(start = [var 2.88675mm, var 0mm], end = [var 1.443375mm, var 2.5mm])
  side2 = line(start = [var 1.443375mm, var 2.5mm], end = [var -1.443375mm, var 2.5mm])
  side3 = line(start = [var -1.443375mm, var 2.5mm], end = [var -2.88675mm, var 0mm])
  side4 = line(start = [var -2.88675mm, var 0mm], end = [var -1.443375mm, var -2.5mm])
  side5 = line(start = [var -1.443375mm, var -2.5mm], end = [var 1.443375mm, var -2.5mm])
  side6 = line(start = [var 1.443375mm, var -2.5mm], end = [var 2.88675mm, var 0mm])
  centerGuide = line(start = [var 0mm, var 0mm], end = [var 2.88675mm, var 0mm], construction = true)
  circumference = circle(start = [var 2.88675mm, var 0mm], center = [var 0mm, var 0mm], construction = true)

  coincident([side1.end, side2.start])
  coincident([side2.end, side3.start])
  coincident([side3.end, side4.start])
  coincident([side4.end, side5.start])
  coincident([side5.end, side6.start])
  coincident([side6.end, side1.start])
  coincident([centerGuide.start, ORIGIN])
  coincident([centerGuide.end, side1.start])
  coincident([circumference.center, ORIGIN])
  coincident([circumference.start, centerGuide.end])
  coincident([side2.start, circumference])
  coincident([side3.start, circumference])
  coincident([side4.start, circumference])
  coincident([side5.start, circumference])
  coincident([side6.start, circumference])

  horizontal(centerGuide)
  horizontal(side2)
  horizontal(side5)
  equalLength([
    side1,
    side2,
    side3,
    side4,
    side5,
    side6
  ])
  radius(circumference) == m25NutPocketCircumradius
  verticalDistance([side2.start, side5.start]) == m25NutPocketAcrossFlats
}
lowerNutPocketCutLeft = extrude(region(point = [0mm, 0mm], sketch = lowerNutPocketProfile), length = m25NutPocketDepth + csgOverlap, method = NEW)
  |> translate(x = -mountHoleX, y = mountHoleY, global = true)
lowerNutPocketCutRight = clone(lowerNutPocketCutLeft)
  |> translate(x = 2 * mountHoleX, global = true)

lowerShellWithNutPockets = subtract(
  lowerShellCut,
  tools = [
    lowerNutPocketCutLeft,
    lowerNutPocketCutRight
  ],
)
hide(lowerNutPocketProfile)

lowerEndPortProfile = sketch(on = offsetPlane(YZ, offset = -outerLength / 2 - csgOverlap)) {
  centerGuide = line(start = [var 0mm, var 0.785mm], end = [var 5mm, var 0.785mm], construction = true)
  portCircle = circle(start = [var 5mm, var 0.785mm], center = [var 0mm, var 0.785mm])

  coincident([portCircle.center, centerGuide.start])
  coincident([portCircle.start, centerGuide.end])
  horizontal(centerGuide)
  horizontalDistance([ORIGIN, centerGuide.start]) == 0mm
  verticalDistance([ORIGIN, centerGuide.start]) == boardTopZ
  diameter(portCircle) == endPortDiameter
}
lowerEndPortLeft = extrude(region(point = [0mm, boardTopZ], sketch = lowerEndPortProfile), length = wallThickness + 2 * csgOverlap, method = NEW)
hide(lowerEndPortProfile)
lowerEndPortRight = clone(lowerEndPortLeft)
  |> translate(x = outerLength - wallThickness, global = true)
lowerShellWithEndPorts = subtract(lowerShellWithNutPockets, tools = [lowerEndPortLeft, lowerEndPortRight])

lowerShellColored = appearance(
  lowerShellWithEndPorts,
  color = lowerShellColor,
  roughness = 78,
  metalness = 0,
  opacity = 82,
)

export lowerShell = lowerShellColored
hidden001 = hide(lowerOuterProfile)
hidden002 = hide(lowerCavityProfile)
hidden003 = hide(lowerPilotProfile)
