/*
Generated by Text-to-CAD:
create a  centrifugal compressor
*/
@settings(defaultLengthUnit = mm, kclVersion = 1.0)

// -------------------- Parameters --------------------
impellerOuterDiameter = 160
hubOuterDiameter = 45
shaftBoreDiameter = 20
backPlateThickness = 6
hubHeight = 36

bladeCount = 12
bladeThickness = 3
bladeBackSweepDeg = 20
bladeRootClearance = 8  // radial gap between hub OD and blade root
frontShroudThickness = 3

diffuserVaneCount = 16
diffuserVaneThickness = 2
diffuserGapRadial = 2    // radial gap between impeller tip and diffuser inner radius
diffuserHeight = 12
diffuserRingThickness = 3

casingWall = 4
casingRadialClear = 6
casingAxialMargin = 8

// -------------------- Derived --------------------
impellerOuterRadius = impellerOuterDiameter / 2
hubOuterRadius = hubOuterDiameter / 2
boreRadius = shaftBoreDiameter / 2

bladeRootRadius = hubOuterRadius + bladeRootClearance
bladeTipRadius = impellerOuterRadius - 2  // small radial offset from OD
bladeRadialSpan = bladeTipRadius - bladeRootRadius
bladeHeight = hubHeight - frontShroudThickness

frontShroudZ = backPlateThickness + bladeHeight
frontShroudOuterRadius = impellerOuterRadius
frontShroudInnerRadius = 26  // eye opening; adjust as needed

diffuserZ = frontShroudZ + frontShroudThickness + 2  // small axial clearance
diffuserInnerRadius = bladeTipRadius + diffuserGapRadial
diffuserOuterRadius = diffuserInnerRadius + 25

casingInnerRadius = diffuserOuterRadius + casingRadialClear
casingOuterRadius = casingInnerRadius + casingWall
casingHeight = backPlateThickness + hubHeight + diffuserRingThickness + diffuserHeight + casingAxialMargin

// -------------------- Helpers --------------------
fn ringSketch(onPlane, innerR, outerR) {
  return startSketchOn(onPlane)
    |> circle(center = [0, 0], radius = outerR)
    |> subtract2d(tool = circle(center = [0, 0], radius = innerR))
}

fn oneBladeSketch(@onFaceOrPlane, startAt, radialSpan, tangentialThickness) {
  return startProfile(onFaceOrPlane, at = startAt)
    |> xLine(length = radialSpan)
    |> yLine(length = tangentialThickness)
    |> xLine(length = -radialSpan)
    |> close()
}

// -------------------- Impeller: Back-plate --------------------
backPlateSketch = startSketchOn(XY)
  |> circle(center = [0, 0], radius = impellerOuterRadius)

backPlate = extrude(backPlateSketch, length = backPlateThickness)

// -------------------- Impeller: Hub --------------------
hubSketch = startSketchOn(backPlate, face = END)
  |> circle(center = [0, 0], radius = hubOuterRadius)

hub = extrude(hubSketch, length = hubHeight)

// -------------------- Impeller: Shaft Bore --------------------
boreStartPlane = offsetPlane(XY, offset = -casingAxialMargin)
boreSketch = startSketchOn(boreStartPlane)
  |> circle(center = [0, 0], radius = boreRadius)

boreCut = extrude(boreSketch, length = casingAxialMargin + backPlateThickness + hubHeight + 5)

// -------------------- Impeller: One Blade --------------------
bladeBaseFace = startSketchOn(backPlate, face = END)
bladeRect = oneBladeSketch(
  bladeBaseFace,
  startAt = [bladeRootRadius, 0],
  radialSpan = bladeRadialSpan,
  tangentialThickness = bladeThickness
)

oneBlade = extrude(bladeRect, length = bladeHeight)
  |> rotate(yaw = -bladeBackSweepDeg)

// Pattern blades
blades = patternCircular3d(
  oneBlade,
  axis = [0, 0, 1],
  center = [0, 0, 0],
  instances = bladeCount,
  arcDegrees = 360
)

// -------------------- Front Shroud (eye opening) --------------------
frontShroudPlane = offsetPlane(XY, offset = frontShroudZ)
frontShroudRing = ringSketch(
  onPlane = frontShroudPlane,
  innerR = frontShroudInnerRadius,
  outerR = frontShroudOuterRadius
)

frontShroud = extrude(frontShroudRing, length = frontShroudThickness)

// -------------------- Diffuser: Rings --------------------
diffuserBottomPlane = offsetPlane(XY, offset = diffuserZ)
diffuserTopPlane = offsetPlane(XY, offset = diffuserZ + diffuserHeight)

diffuserBottomRingSketch = ringSketch(
  onPlane = diffuserBottomPlane,
  innerR = diffuserInnerRadius,
  outerR = diffuserOuterRadius
)
diffuserBottomRing = extrude(diffuserBottomRingSketch, length = diffuserRingThickness)

diffuserTopRingSketch = ringSketch(
  onPlane = diffuserTopPlane,
  innerR = diffuserInnerRadius,
  outerR = diffuserOuterRadius
)
diffuserTopRing = extrude(diffuserTopRingSketch, length = diffuserRingThickness)

// -------------------- Diffuser: Vanes --------------------
vaneBasePlane = offsetPlane(XY, offset = diffuserZ)
vaneRectSketch = startSketchOn(vaneBasePlane)
  |> startProfile(at = [diffuserInnerRadius, 0])
  |> xLine(length = diffuserOuterRadius - diffuserInnerRadius)
  |> yLine(length = diffuserVaneThickness)
  |> xLine(length = -(diffuserOuterRadius - diffuserInnerRadius))
  |> close()

oneDiffuserVane = extrude(vaneRectSketch, length = diffuserHeight)

diffuserVanes = patternCircular3d(
  oneDiffuserVane,
  axis = [0, 0, 1],
  center = [0, 0, 0],
  instances = diffuserVaneCount,
  arcDegrees = 360
)

// -------------------- Casing (simple cylindrical shell) --------------------
// casingPlane = offsetPlane(XY, offset = 0)
// casingRingSketch = ringSketch(
//   onPlane = casingPlane,
//   innerR = casingInnerRadius,
//   outerR = casingOuterRadius
// )
// casing = extrude(casingRingSketch, length = casingHeight)

