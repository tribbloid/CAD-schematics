/* Generated by Text-to-CAD:
Create a pipe adapter with smooth loft from input to the output:
- Input: 3/4 inch diameter (measured from inside), inside should be threaded (3/4 inch)
- Ouptut: 1-3/8 inch diameter (measured from outside), with 5mm flange */
@settings(defaultLengthUnit = in, kclVersion = 1.0)

// -----------------------------------------------------------------------------
// Pipe adapter with smooth loft and flange + cosmetic internal helical thread
// -----------------------------------------------------------------------------

// Inputs/Key dimensions
inletInnerDiameter = 0.75 // 3/4" internal thread nominal
outletOuterDiameter = 1.375 // 1-3/8" outside diameter at outlet
flangeThickness = 2mm // Flange axial thickness
// Editable design choices
wallThickness = 0.07874 // Uniform wall thickness (2 mm)
threadLength = 0.50 // Length of straight threaded section at inlet
transitionLength = 1.50 // Length of tapered transition to outlet
flangeOuterDiameter = 2.0 // Overall flange outside diameter


// Cosmetic/internal thread parameters (edit as needed)
threadMajorDia = inletInnerDiameter // major diameter for internal thread
threadPitch = 0.0590551181 // thread pitch (1.5 mm in inches)
threadRevs = threadLength / threadPitch // number of revolutions over threadLength
threadStartAngle = 0deg // start angle
threadWireDia = 0.035 // sweep profile "wire" diameter (small)
// Note: This is a lightweight representation: a swept coil cut; not a standards-true profile.

// Derived
inletOuterDiameter = inletInnerDiameter + 2 * wallThickness
outletInnerDiameter = outletOuterDiameter - (2 * wallThickness)
totalBodyLength = threadLength + transitionLength

// Sketch 0: inlet annulus (start of straight threaded section)
inletAnnulus0 = startSketchOn(XY)
  |> circle(center = [0, 0], radius = inletOuterDiameter / 2)
  |> subtract2d(tool = circle(center = [0, 0], radius = inletInnerDiameter / 2))

// Sketch 1: end of straight threaded section (same diameters as inlet)
inletAnnulus1 = startSketchOn(offsetPlane(XY, offset = threadLength))
  |> circle(center = [0, 0], radius = inletOuterDiameter / 2)
  |> subtract2d(tool = circle(center = [0, 0], radius = inletInnerDiameter / 2))

// Sketch 2: outlet annulus (target diameters at end of transition)
outletAnnulus = startSketchOn(offsetPlane(XY, offset = totalBodyLength))
  |> circle(center = [0, 0], radius = outletOuterDiameter / 2)
  |> subtract2d(tool = circle(center = [0, 0], radius = outletInnerDiameter / 2))

// Loft the hollow adapter body (straight section -> smooth transition)
adapterBody = loft([
  inletAnnulus0,
  inletAnnulus1,
  outletAnnulus
])

// Add outlet flange: a ring added on the outlet end face
flangeSketch = startSketchOn(adapterBody, face = END)
  |> circle(center = [0, 0], radius = flangeOuterDiameter / 2)
  |> subtract2d(tool = circle(center = [0, 0], radius = outletOuterDiameter / 2))
adapterWithFlange = extrude(flangeSketch, length = flangeThickness)

// -----------------------------------------------------------------------------
// Add cosmetic internal helical thread at inlet by subtractive coil sweep
// -----------------------------------------------------------------------------

// Create a helix path centered on Z axis at inlet; radius is to the thread major diameter
inletHelix = helix(
  angleStart = threadStartAngle,
  ccw = true,
  revolutions = threadRevs,
  length = threadLength,
  radius = threadMajorDia / 2,
  axis = Z,
)

// Create a small circular profile slightly inside the major diameter and sweep along helix
// Place the profile on XZ so that its center is at the helix radius on X axis
threadCutterProfile = startSketchOn(XZ)
  |> circle(center = [threadMajorDia / 2, 0], radius = threadWireDia / 2)

// Sweep the cutter and subtract from the body to emulate an internal thread groove
threadCutter = sweep(threadCutterProfile, path = inletHelix)
adapterWithThread = subtract([adapterWithFlange], tools = [threadCutter])

// Optional: color for clarity
appearance(adapterWithThread, color = "#8faadc")

// Notes:
// - This creates a cosmetic/internal thread by sweeping a small circular cutter along a helix,
// then subtracting it from the inlet bore over threadLength.
// - Adjust threadPitch and threadWireDia to get the desired visual density and depth.
// - For a standards-accurate thread form, replace the circular cutter with the proper profile.
